# Optional. The site already uses the live Supabase project; copy this to .env.local only to
# point it somewhere else. Both values are safe to expose to browsers: what each account can do
# is enforced by row level security in the database.
VITE_SUPABASE_URL=https://cvijqlbtakistuikogoz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_yVwFuNNXXeM09nneiZZOig_MnaBvmDT

# Only on your own computer, never on the host: the secret key that lets `npm run upload-content`
# put lesson content into the database (Supabase → Project Settings → API Keys → Secret keys).
# The Admin page's "Upload content" button does the same without it.
# SUPABASE_SECRET_KEY=sb_secret_...
