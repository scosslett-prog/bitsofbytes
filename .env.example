# Copy to .env.local for local development, and add the same two values in Vercel
# (Project → Settings → Environment Variables). Both are safe to expose to browsers:
# what each account can do is enforced by row level security in the database.
VITE_SUPABASE_URL=https://cvijqlbtakistuikogoz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_yVwFuNNXXeM09nneiZZOig_MnaBvmDT

# Show "Continue with Google" on the sign-in and sign-up pages. Turn on once the Google
# provider is set up in Supabase (see README, "Sign in with Google").
VITE_GOOGLE_SIGN_IN=off

# Turn on payments (free tier for everyone else) once Stripe is set up (see README, "Payments with Stripe").
VITE_PAYMENTS=off
